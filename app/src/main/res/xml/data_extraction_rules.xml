<?xml version="1.0" encoding="utf-8"?>
<!--
  Data-extraction rules for Android 12+ (API 31+).

  This app keeps health data and AI service keys only on the device. Neither
  cloud backup nor device-to-device transfer should move that data anywhere, so
  every sensible domain is excluded. Kept alongside backup_rules.xml because
  Android uses this file on newer versions and the other on older ones.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
